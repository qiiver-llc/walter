#!/home/walter/walter/.venv/bin/python
"""walter-canvas: show rich content in a panel that slides in on the right of Walter's face.

  walter-canvas show FILE.md|FILE.html|- [--title T] [--seconds N] [--md|--html]
  walter-canvas hide
  walter-canvas scroll down|up|top|bottom
  walter-canvas status

Markdown (GitHub-flavoured: headings, lists, tables, code with syntax highlighting,
images, links) or a full HTML page with CSS + JavaScript. Everything renders in a
sandboxed iframe (no network: connect-src 'none'). In HTML you may load the vendored
libraries:  <script src="vendor/chart.umd.min.js"></script>  (Chart.js 4, with dark
defaults pre-applied), vendor/marked.min.js, vendor/highlight.min.js, vendor/purify.min.js.
Local images referenced by relative/absolute path in Markdown, or in <img src> in HTML,
are inlined automatically. '-' reads stdin (HTML if it starts with '<', else Markdown).
Default: auto-hides after 3 minutes; --seconds 0 = stays until hidden (or Escape).

Writes face/canvas-doc.json + face/canvas.json with a fixed old mtime so the face's
auto-reload ignores them; the face polls canvas.json every 1.5 s.
"""
import argparse, base64, json, mimetypes, os, re, sys, tempfile, time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
FACE = REPO / "face"
CTRL, DOC = FACE / "canvas.json", FACE / "canvas-doc.json"
FIXED_MTIME = 946684800  # 2000-01-01: never looks like a face edit
MAX_IMG = 8 * 1024 * 1024


def write(path: Path, data: dict) -> None:
    # temp file outside face/ (same filesystem) so the face watcher never sees a fresh mtime
    fd, tmp = tempfile.mkstemp(dir=REPO, prefix=".canvas-", suffix=".tmp")
    with os.fdopen(fd, "w") as f:
        json.dump(data, f)
    os.chmod(tmp, 0o644)
    os.utime(tmp, (FIXED_MTIME, FIXED_MTIME))
    os.replace(tmp, path)


def read_ctrl() -> dict:
    try:
        return json.loads(CTRL.read_text())
    except Exception:
        return {}


def inline_image(ref: str, base: Path) -> str:
    if re.match(r"^(https?:|data:|blob:|vendor/|#)", ref):
        return ref
    p = Path(os.path.expanduser(ref.split("#")[0].split("?")[0]))
    if not p.is_absolute():
        p = base / p
    try:
        if p.is_file() and p.stat().st_size <= MAX_IMG:
            mime = mimetypes.guess_type(p.name)[0] or "application/octet-stream"
            return f"data:{mime};base64," + base64.b64encode(p.read_bytes()).decode()
    except OSError:
        pass
    return ref


def inline_images(text: str, kind: str, base: Path) -> str:
    if kind == "md":
        text = re.sub(r"(!\[[^\]]*\]\()\s*<?([^)\s>]+)>?((?:\s+\"[^\"]*\")?\s*\))",
                      lambda m: m.group(1) + inline_image(m.group(2), base) + m.group(3), text)
    return re.sub(r"(<img\b[^>]*?\bsrc\s*=\s*)([\"'])(.*?)\2",
                  lambda m: m.group(1) + m.group(2) + inline_image(m.group(3), base) + m.group(2), text, flags=re.I)


def guess_title(text: str, kind: str, name: str) -> str:
    if kind == "md":
        m = re.search(r"^\s{0,3}#{1,3}\s+(.+?)\s*#*\s*$", text, re.M)
    else:
        m = re.search(r"<title[^>]*>(.*?)</title>", text, re.I | re.S) or re.search(r"<h1[^>]*>(.*?)</h1>", text, re.I | re.S)
    if m:
        return re.sub(r"<[^>]+>|[*_`]", "", m.group(1)).strip()[:80]
    return name


def main() -> None:
    ap = argparse.ArgumentParser(prog="walter-canvas", description="Rich content panel on Walter's face.",
                                 formatter_class=argparse.RawDescriptionHelpFormatter, epilog=__doc__)
    sub = ap.add_subparsers(dest="cmd")
    s = sub.add_parser("show", help="show a Markdown or HTML file ('-' = stdin)")
    s.add_argument("file")
    s.add_argument("--title", "-t")
    s.add_argument("--seconds", "-s", type=float, default=180, help="auto-hide after N seconds (default 180; 0 = stay until hidden)")
    g = s.add_mutually_exclusive_group()
    g.add_argument("--md", action="store_true", help="force Markdown")
    g.add_argument("--html", action="store_true", help="force HTML")
    sub.add_parser("hide", help="slide the canvas away")
    sc = sub.add_parser("scroll", help="scroll the canvas")
    sc.add_argument("dir", choices=["down", "up", "top", "bottom"])
    sub.add_parser("status", help="what's on the canvas")
    a = ap.parse_args()

    now = time.time()
    if a.cmd == "show":
        if a.file == "-":
            text, name, base = sys.stdin.read(), "Canvas", Path.cwd()
        else:
            p = Path(a.file).expanduser()
            if not p.is_file():
                sys.exit(f"walter-canvas: no such file: {p}")
            text, name, base = p.read_text(errors="replace"), p.stem.replace("-", " ").replace("_", " "), p.parent
        if a.html:
            kind = "html"
        elif a.md:
            kind = "md"
        elif a.file != "-":
            kind = "html" if Path(a.file).suffix.lower() in (".html", ".htm", ".svg") else "md"
        else:
            kind = "html" if text.lstrip().startswith("<") else "md"
        text = inline_images(text, kind, base)
        title = a.title if a.title is not None else guess_title(text, kind, name)
        write(DOC, {"id": now, "kind": kind, "content": text})
        write(CTRL, {"id": now, "title": title, "kind": kind,
                     "until": (now + a.seconds) if a.seconds > 0 else 0, "scroll": read_ctrl().get("scroll")})
        size = len(text.encode())
        print(f"canvas: showing {kind} \"{title}\" ({size // 1024} KB)" + (f" for {a.seconds:g} s" if a.seconds > 0 else ""))
        if size > 5 * 1024 * 1024:
            print("warning: that's large; the face may be slow to render it", file=sys.stderr)
    elif a.cmd == "hide":
        c = read_ctrl()
        write(CTRL, {"id": now, "hide": True, "scroll": c.get("scroll")})
        print("canvas: hidden")
    elif a.cmd == "scroll":
        c = read_ctrl()
        c["scroll"] = {"id": now, "dir": a.dir}
        write(CTRL, c)
        print(f"canvas: scroll {a.dir}")
    elif a.cmd == "status":
        c = read_ctrl()
        if not c or c.get("hide"):
            print("canvas: hidden")
        elif c.get("until") and now > c["until"]:
            print(f"canvas: hidden (\"{c.get('title', '')}\" timed out)")
        else:
            left = f", {int(c['until'] - now)} s left" if c.get("until") else ""
            print(f"canvas: showing {c.get('kind', '?')} \"{c.get('title', '')}\"{left} (Escape on the keyboard may have closed it)")
    else:
        ap.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
