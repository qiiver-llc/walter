#!/home/walter/walter/.venv/bin/python
"""walter-show: put an information card on Walter's face.

  walter-show "Title" "Body text (newlines ok)" [seconds]   show a card (default 30 s, 0 = until cleared)
  walter-show --qr "data" "Title" "Body" [seconds]          show a card with a QR code
  walter-show --clear                                       remove it

Writes face/card.json with a fixed mtime so the face's auto-reload ignores it;
the face polls it every 2 seconds.
"""
import json, os, sys, time
from pathlib import Path

OUT = Path(__file__).resolve().parent.parent / "face" / "card.json"
FIXED_MTIME = 946684800  # 2000-01-01: never looks like a face edit

def write(data):
    tmp = OUT.with_suffix(".tmp")
    tmp.write_text(json.dumps(data))
    os.utime(tmp, (FIXED_MTIME, FIXED_MTIME))
    os.replace(tmp, OUT)

if len(sys.argv) >= 4 and sys.argv[1] == "--qr":
    import base64, io, qrcode, qrcode.image.svg
    buf = io.BytesIO()
    qrcode.make(sys.argv[2], image_factory=qrcode.image.svg.SvgPathImage, border=1).save(buf)
    secs = float(sys.argv[5]) if len(sys.argv) > 5 else 600
    write({"id": time.time(), "title": sys.argv[3], "body": sys.argv[4] if len(sys.argv) > 4 else "",
           "img": "data:image/svg+xml;base64," + base64.b64encode(buf.getvalue()).decode(),
           "until": (time.time() + secs) if secs > 0 else 0})
elif len(sys.argv) >= 2 and sys.argv[1] == "--clear":
    write({"id": time.time(), "clear": True})
elif len(sys.argv) >= 3:
    secs = float(sys.argv[3]) if len(sys.argv) > 3 else 30
    write({"id": time.time(), "title": sys.argv[1], "body": sys.argv[2],
           "until": (time.time() + secs) if secs > 0 else 0})
else:
    print(__doc__); sys.exit(1)
