#!/bin/sh
# walter-face: mic + speaker agent for a Walter face (walter/face_agent.py, docs/FACES.md)
here=$(dirname "$(readlink -f "$0")")
root=$(dirname "$here")
py="$root/.venv/bin/python"
[ -x "$py" ] || py=python3
PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" exec "$py" -m walter.face_agent "$@"
