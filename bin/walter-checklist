#!/usr/bin/env python3
"""walter-checklist: publish Walter's backlog (~/.walter/home/backlog.md) to the face.

Parses lines like "- [ready] Do a thing (details...)" and writes face/checklist.json
with a fixed mtime (so the face's auto-reload ignores it). Run by walter-checklist.path
whenever backlog.md changes. The face only shows the list while I'm working on an
item, for 1 minute after it changes, or after `walter-checklist --show SECONDS`.
"""
import datetime as dt, json, os, re, sys
from pathlib import Path

SRC = Path(os.environ.get("WALTER_DATA", Path.home() / ".walter")) / "home" / "backlog.md"
OUT = Path(__file__).resolve().parent.parent / "face" / "checklist.json"
FIXED_MTIME = 946684800

items = []
try:
    for line in SRC.read_text().splitlines():
        m = re.match(r"\s*[-*]\s*\[([^\]]+)\]\s*(.+)", line)
        if not m:
            continue
        status, text = m.group(1).strip().lower(), m.group(2).strip()
        b = re.match(r"\*\*(.+?)\*\*", text)  # "**Short title**: details" preferred
        short = b.group(1) if b else re.split(r"[.;(]\s|\s\(", text, maxsplit=1)[0].rstrip(".:;( ")
        if len(short) > 60:
            short = short[:57].rstrip() + "…"
        kind = ("done" if status.startswith("done") else "doing" if "progress" in status
                else "ask" if status.startswith("ask") else "todo")
        item = {"text": short, "status": kind}
        if kind == "done":  # "[done 2026-11-04 09:17]": the face shows it for 15 minutes
            t = re.search(r"(\d{4}-\d{2}-\d{2})[ T](\d{1,2}:\d{2})", status)
            item["done_at"] = dt.datetime.fromisoformat(f"{t.group(1)} {t.group(2).zfill(5)}").timestamp() if t else 0
        items.append(item)
except OSError:
    pass
import time
now = time.time()
prev = {}
try:
    prev = json.loads(OUT.read_text())
except (OSError, ValueError):
    pass
show_until = prev.get("show_until", 0)
if len(sys.argv) > 2 and sys.argv[1] == "--show":  # walter-checklist --show 60
    show_until = now + float(sys.argv[2])
changed_at = prev.get("changed_at", 0) if prev.get("items") == items else now
tmp = OUT.with_suffix(".tmp")
tmp.write_text(json.dumps({"items": items, "changed_at": changed_at, "show_until": show_until}))
os.utime(tmp, (FIXED_MTIME, FIXED_MTIME))
os.replace(tmp, OUT)
print(f"checklist: {len(items)} items")
